<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Control Banner -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Title & Top Action Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <!-- Mode Toggle Button (Simulation <-> Live) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_mode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/mode_sim"
                    android:textColor="@color/accent_blue"
                    app:strokeColor="@color/accent_blue"
                    app:strokeWidth="1dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <!-- Battery Optimization Exemption Button -->
                <ImageButton
                    android:id="@+id/btn_battery_opt"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_battery_bolt"
                    app:tint="@color/accent_orange"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/desc_battery_opt" />

            </LinearLayout>

            <!-- Status Badges & Counters Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <!-- Status Pill -->
                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_status_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/status_idle"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Tasks Count Badge -->
                <TextView
                    android:id="@+id/tv_tasks_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks: 0 / 5"
                    android:textColor="@color/secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Clicks Count Badge -->
                <TextView
                    android:id="@+id/tv_clicks_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Clicks: 0"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Big Start / Pause Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_pause"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_start"
                app:backgroundTint="@color/secondary"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:elevation="2dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Persistent WebView Container -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#242220" />

</LinearLayout>
